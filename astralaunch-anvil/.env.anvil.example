# Copy to .env.anvil and fill in MONAD_RPC_URL.
MONAD_RPC_URL=https://your-monad-mainnet-rpc
FORK_BLOCK=                  # optional: pin a block for reproducible runs
CHAIN_ID=143
ANVIL_PORT=8545
ANVIL_RPC_URL=http://127.0.0.1:8545

# Monad mainnet USDC. Source: @x402/evm 2.26.0 default assets for eip155:143. Verify on a Monad explorer.
USDC_ADDRESS=0x754704Bc059F8C67012fEd69BC8A327a5aafb603
USDC_EIP712_VERSION=2        # test 01 prints the on-chain value; keep them equal

# Astralaunch launch parameters under test
POOL_FEE=20000               # 2% (Uniswap v4 fee units, SDK max 100000)
TICK_SPACING=200             # required for a non-standard fee
START_MCAP_USD=10000         # open decision O1

FACILITATOR_PORT=4020
