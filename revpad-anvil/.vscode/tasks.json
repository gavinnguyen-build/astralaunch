{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Anvil: start Monad fork",
      "type": "shell",
      "command": "./anvil/start-fork.sh",
      "isBackground": true,
      "problemMatcher": {
        "owner": "anvil",
        "pattern": { "regexp": "^__never__$" },
        "background": { "activesBegin": "Forking Monad", "endsPattern": "Listening on" }
      },
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Anvil: fund test wallets (USDC)",
      "type": "shell",
      "command": "./anvil/fund.sh ${input:usdcAmount}",
      "problemMatcher": []
    },
    { "label": "Anvil: snapshot save", "type": "shell", "command": "./anvil/snapshot.sh save", "problemMatcher": [] },
    { "label": "Anvil: snapshot revert", "type": "shell", "command": "./anvil/snapshot.sh revert", "problemMatcher": [] },
    {
      "label": "Anvil: time travel (days)",
      "type": "shell",
      "command": "./anvil/time-travel.sh ${input:days}",
      "problemMatcher": []
    },
    { "label": "Test 01: check environment", "type": "shell", "command": "npm run check", "problemMatcher": [] },
    { "label": "Test 02: launch token (Revpad config)", "type": "shell", "command": "npm run launch", "problemMatcher": [] },
    {
      "label": "Test 03: buy + sell",
      "type": "shell",
      "command": "npm run trade -- ${input:buyUsdc}",
      "problemMatcher": []
    },
    { "label": "Test 04: fee split per beneficiary", "type": "shell", "command": "npm run fees", "problemMatcher": [] },
    { "label": "Test 05: vesting cliff + schedule", "type": "shell", "command": "npm run vesting", "problemMatcher": [] },
    {
      "label": "x402: local facilitator",
      "type": "shell",
      "command": "npm run facilitator",
      "isBackground": true,
      "problemMatcher": {
        "owner": "x402",
        "pattern": { "regexp": "^__never__$" },
        "background": { "activesBegin": ".", "endsPattern": "Local x402 facilitator on" }
      },
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Test 07: x402 payment",
      "type": "shell",
      "command": "npm run pay",
      "dependsOn": ["x402: local facilitator"],
      "problemMatcher": []
    },
    {
      "label": "Revpad: full flow (fund → check → launch → trade → fees → vesting)",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Anvil: fund test wallets (USDC)",
        "Test 01: check environment",
        "Test 02: launch token (Revpad config)",
        "Test 03: buy + sell",
        "Test 04: fee split per beneficiary",
        "Test 05: vesting cliff + schedule"
      ],
      "problemMatcher": []
    },
    { "label": "Typecheck scripts", "type": "shell", "command": "npm run typecheck", "problemMatcher": ["$tsc"] }
  ],
  "inputs": [
    { "id": "usdcAmount", "type": "promptString", "description": "USDC per test wallet", "default": "10000" },
    { "id": "days", "type": "promptString", "description": "Days to move forward", "default": "31" },
    { "id": "buyUsdc", "type": "promptString", "description": "USDC to spend on the buy", "default": "50" }
  ]
}
