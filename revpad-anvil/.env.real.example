# Real Monad mainnet checks — copy this file to .env.real and fill in.
# .env.real is in .gitignore and will never be committed.

# Your real private key on Monad mainnet (NOT one of the Anvil dev accounts).
# The wallet needs at least 0.02 USDC for real-02-pay.ts.
# MON balance is NOT required — the x402 facilitator pays gas.
REAL_PRIVATE_KEY=0x...

# Optional: destination address for the x402 payment in real-02-pay.ts.
# Defaults to the sender address (self-payment) if not set.
# REAL_PAYTO=0x...

# Optional: Monad mainnet RPC URL. Defaults to https://rpc.monad.xyz
# REAL_RPC_URL=https://rpc.monad.xyz
