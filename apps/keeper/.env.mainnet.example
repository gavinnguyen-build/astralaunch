# Mainnet keeper config — copy to .env.mainnet and fill in secrets
MONAD_RPC_URL=https://rpc.monad.xyz
MONAD_CHAIN_ID=143
ASTRALAUNCH_REGISTRY_ADDRESS=0x6B3A79C723AB69f8938C87209E1D9730c739e00c
FEE_ESCROW_ADDRESS=0xA070ad1387d525E4A180Bdb09B65FD4086858F15
BUYBACK_VAULT_ADDRESS=0x394F1dcA6011C16BC6e70CA13F6F29767D92171E
PLATFORM_FEE_RECEIVER_ADDRESS=0x2eFE45394d7578dC39c75d06Fe88722118F5Ec76
CONTRACTS_JSON_PATH=../../packages/contracts/deployments/monad-mainnet.json
ADMIN_ADDRESS=0xe89f19D370F496520803e7ABb30c1A20B04B0f7f
KEEPER_PRIVATE_KEY=                   # keeper wallet 0x9e641007829DA8eB199b2Bec64B1E6dcbfdaB854 only
# Token discovery: listed tokens (launch fee consumed, not hidden) are read from the server DB each tick.
DATABASE_URL=postgresql://astralaunch:PASSWORD@HOST:5432/astralaunch_mainnet
# Debug override only (leave empty): ASSETS alone = those tokens from the DB, listed or not;
# ASSETS + ROUTERS = explicit pairs without a database.
ASSETS=
ROUTERS=
POLL_INTERVAL_S=600                   # minimum 300 on a non-local RPC
KEEPER_HEALTH_PORT=8080               # GET /health; 503 when no tick succeeded within 3x POLL_INTERVAL_S
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
