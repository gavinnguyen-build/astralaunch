{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astralaunch.dev/schemas/sight-signals.json",
  "title": "Sight signals (GET /sight/signals?handle=…), SAMPLE DATA",
  "type": "object",
  "additionalProperties": false,
  "required": ["handle", "source", "notice", "signals"],
  "properties": {
    "handle": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,15}$" },
    "source": { "const": "sample data" },
    "notice": { "type": "string", "minLength": 1 },
    "signals": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "id", "kind", "text", "score"],
        "properties": {
          "rank":  { "type": "integer", "minimum": 1, "maximum": 5 },
          "id":    { "type": "string", "pattern": "^s[0-9]{2}$" },
          "kind":  { "enum": ["mention", "reply", "quote", "trend", "follow"] },
          "text":  { "type": "string", "minLength": 1 },
          "score": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    }
  }
}
