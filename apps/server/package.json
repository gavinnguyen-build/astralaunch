{
  "name": "@astralaunch/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --experimental-transform-types src/index.ts",
    "start:mainnet": "tsx src/start-mainnet.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "admin:list-legacy": "tsx src/scripts/listLegacyTokens.ts",
    "admin:backfill-tokens": "tsx src/scripts/backfillTokens.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@astralaunch/shared": "workspace:*",
    "@cfworker/json-schema": "^4.1.1",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.1",
    "@x402/core": "2.26.0",
    "@x402/evm": "2.26.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0",
    "postgres": "^3.4.5",
    "viem": "^2.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.1"
  }
}
